{
  "description": "oh-my-harness Codex hooks — ordered convention, verification, and safety pipelines",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex/run.mjs\" SessionStart",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex\\run.mjs\" SessionStart",
            "timeout": 12,
            "statusMessage": "oh-my-harness: loading project conventions"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex/run.mjs\" UserPromptSubmit",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex\\run.mjs\" UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "oh-my-harness: evaluating request"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex/run.mjs\" PreToolUse",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex\\run.mjs\" PreToolUse",
            "timeout": 15,
            "statusMessage": "oh-my-harness: checking safety, plan, and scope"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex/run.mjs\" PostToolUse",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex\\run.mjs\" PostToolUse",
            "timeout": 8,
            "statusMessage": "oh-my-harness: recording tool outcome"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex/run.mjs\" PreCompact",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex\\run.mjs\" PreCompact",
            "timeout": 7,
            "statusMessage": "oh-my-harness: saving context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex/run.mjs\" Stop",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\codex\\run.mjs\" Stop",
            "timeout": 1210,
            "statusMessage": "oh-my-harness: evaluating loop, verification, and completion"
          }
        ]
      }
    ]
  }
}
